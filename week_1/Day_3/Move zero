class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        for(int i=0;i<nums.size();i++){
            if(nums[i]==0){
                for(int j=i+1;j<nums.size();j++){
                    if(nums[i]==nums[j])
                    continue;
                    else{
                        swap(nums[i],nums[j]);
                        i++;
                
                    }
                    
                    
                }
            }
  
        }
        
    }
};
