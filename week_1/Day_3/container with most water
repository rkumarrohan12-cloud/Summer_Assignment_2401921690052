class Solution {
public:
    int maxArea(vector<int>& height) {
        int n=height.size();
        int l=0;
        int r=n-1;
        vector<int>area;
        while(l<r){
            int w=r-l;
            int h=min(height[l],height[r]);
            int newarea=w*h;
                area.push_back(newarea);
                if(height[l]<height[r]){
                    l++;
                    }
                    
                    else
                    r--;

        }
        int maxVal = *max_element(area.begin(), area.end());

         return maxVal;
        
    }
};
