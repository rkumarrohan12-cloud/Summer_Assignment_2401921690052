class Solution{
 public:
    vector<int> findAnagrams(string s, string p) {
         
         int n=s.length();
        int m=p.length();
        if(n<m){
            return {};
        }
        vector<int>c1(26,0);
        vector<int>c2(26,0);
        vector<int>ans;
        for(int i=0;i<m;i++){
            c1[p[i]-'a']++;
        }
        for(int i=0;i<n;i++){
            c2[s[i]-'a']++;

            if(i>=m){
                c2[s[i-m]-'a']--;

            }
            if(c1==c2){
                ans.push_back(i-m+1);
            }
        }
       return ans;

       
    }
};
