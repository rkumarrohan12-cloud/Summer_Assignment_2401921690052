class Solution {
public:
    int compress(vector<char>& chars) {
        int n=chars.size();
        int idx=0;
        for(int i=0;i<n;i++){
            int ch=chars[i];
            int count=0;
            while(i<n && ch==chars[i]){
                i++;
                count++;
            }
            if(count==1){
                chars[idx]=ch;
                idx++;
            }
            else{
                chars[idx++]=ch;
                string s=to_string(count);
                for( char c : s){
                    chars[idx++]=c;
                }
            }
            i--;
        }
       
        return idx;
    }
};
